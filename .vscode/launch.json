{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug C (arquivo ativo)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "cwd": "${fileDirname}",
      "stopAtEntry": false,
      "externalConsole": false,
      "preLaunchTask": "C/C++: Build Active File",
      "linux": {
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb",
        "setupCommands": [
          { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
        ]
      },
      "osx": {
        "MIMode": "lldb"
      }
    },
    {
      "name": "Debug C com CodeLLDB (arquivo ativo)",
      "type": "lldb",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "cwd": "${fileDirname}",
      "preLaunchTask": "C/C++: Build Active File"
    }
  ]
}
